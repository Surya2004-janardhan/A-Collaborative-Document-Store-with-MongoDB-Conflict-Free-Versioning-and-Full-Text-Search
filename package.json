    "@types/jest": "^30.0.0",
    "@types/node": "^20.8.10",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
